# Xray
XRAY_CONFIG=/opt/node-plane-runtime/xray/config.json
XRAY_CONTAINER_NAME=xray
XRAY_DOCKER_DIR=/opt/node-plane-runtime/xray
# Unset: the deploy script's default, which follows releases. A runtime update
# removes a value that an earlier release wrote as its default; any other value
# is kept as an override.
# XRAY_DOCKER_IMAGE=registry.example/xray:tag@sha256:...
XRAY_INBOUND_TCP_TAG=reality-tcp
XRAY_INBOUND_XHTTP_TAG=reality-xhttp

# AWG / AmneziaWG
AWG_CONTAINER_NAME=amnezia-awg
AWG_DOCKER_DIR=/opt/node-plane-runtime/amnezia-awg
# AWG_DOCKER_IMAGE: as XRAY_DOCKER_IMAGE; the image is built on the node.
AWG_IFACE=wg0
AWG_CONFIG=/opt/node-plane-runtime/amnezia-awg/data/wg0.conf
AWG_SERVER_ADDRESS=10.8.1.0/24
AWG_NETWORK=10.8.1.0/24
AWG_DNS=1.1.1.1
AWG_MTU=1280
AWG_ALLOWED_IPS=0.0.0.0/0,::/0

# Server egress for both AWG and Xray; client IPv6 capture remains enabled.
IPV6_OUTBOUND=on
AWG_KEEPALIVE=25
AWG_I1_PRESET=quic
